# ==========================================
# Setu IoT Backend - Environment Template
# Duplicate this file to .env and fill in values
# ==========================================
PROJECT_NAME="Setu IoT Backend"
API_V1_STR="/api/v1"
SETU_SECRET_KEY="replace-with-a-secure-random-secret-key-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# PostgreSQL Database Configuration
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/setu"

# Regional Defaults (Mulbagal Cluster, Karnataka)
DEFAULT_REGION="Mulbagal, Kolar, Karnataka"
DEFAULT_LATITUDE=13.1633
DEFAULT_LONGITUDE=78.3944
