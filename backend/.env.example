# ==========================================
# Setu IoT Backend - Environment Template
# Duplicate this file to .env and fill in values
# ==========================================
PROJECT_NAME="Setu"
API_V1_STR="/api/v1"
SETU_SECRET_KEY="setu-local-dev-secret-change-me"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# PostgreSQL Database Configuration
DATABASE_URL="postgresql://setu_user:setu_password@127.0.0.1:5432/setu"

# Security & Access Control
INITIAL_ADMIN_PASSWORD="admin"
DEVICE_API_KEY="setu-iot-device-key-2026"
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000,http://localhost:5173"

# Optional Firebase Service Account
FIREBASE_CREDENTIALS_PATH=""
FIREBASE_SERVICE_ACCOUNT_JSON=""

# Twilio / WhatsApp Notifications
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"
TWILIO_WHATSAPP_TO=""
