# ==========================================
# Setu System - Environment Configuration
# Duplicate this file to .env or backend/.env
# ==========================================

# Backend Configuration
PROJECT_NAME="Setu"
API_V1_STR="/api/v1"
SETU_SECRET_KEY="setu-local-dev-secret-change-me"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# PostgreSQL Database Configuration
DATABASE_URL="postgresql://setu_user:setu_password@127.0.0.1:5432/setu"

# Regional Defaults (Global Worldwide Dynamic Geocoding)
DEFAULT_REGION="Global Sericulture Network"
DEFAULT_LATITUDE=0.0
DEFAULT_LONGITUDE=0.0

# Super Admin Default Access (Seed Configuration)
# ADMIN_USER="admin"
# ADMIN_PASS="admin"

# Twilio / WhatsApp Notifications
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"
TWILIO_WHATSAPP_TO=""
