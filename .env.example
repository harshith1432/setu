# ==============================================================================
# SeriCare / Setu Enterprise Platform - Environment Configuration
# Duplicate this file to .env or backend/.env
# ==============================================================================

# Backend Core Configuration
PROJECT_NAME="SeriCare"
API_V1_STR="/api/v1"
SETU_SECRET_KEY="setu-production-secret-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080  # 7 days

# PostgreSQL Database Configuration
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/setu"
DB_POOL_MAX=50

# Security & CORS
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000,http://localhost:5173,http://127.0.0.1:5173,https://setu-adminweb.vercel.app,https://setu-8vh9.onrender.com"
INITIAL_ADMIN_PASSWORD="admin"
DEVICE_API_KEY="setu-iot-device-key-2026"

# Regional Defaults (Global Worldwide Dynamic Geocoding)
DEFAULT_REGION="Karnataka Sericulture Network"
DEFAULT_LATITUDE=12.9716
DEFAULT_LONGITUDE=77.5946

# Twilio / WhatsApp Notifications (Optional Provider)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"
TWILIO_WHATSAPP_TO=""
WHATSAPP_ALERT_COOLDOWN_SECONDS=300
WHATSAPP_CRITICAL_COOLDOWN_SECONDS=900

# Razorpay Payment Gateway (Optional Provider)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Cloud Storage / S3 (Optional Provider)
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_S3_BUCKET_NAME=""
AWS_REGION="ap-south-1"

# MQTT Broker (Optional Gateway Provider)
MQTT_BROKER_HOST="127.0.0.1"
MQTT_BROKER_PORT=8883
MQTT_CLIENT_CERT_PATH=""
