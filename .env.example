# ==========================================
# Setu System - Environment Configuration
# Duplicate this file to .env or backend/.env
# ==========================================

# Backend Configuration
PROJECT_NAME="Setu IoT Backend"
API_V1_STR="/api/v1"
SETU_SECRET_KEY="replace-with-a-secure-random-secret-key-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# PostgreSQL Database Configuration
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/setu"

# Regional Defaults (Global Worldwide Dynamic Geocoding)
DEFAULT_REGION="Global Sericulture Network"
DEFAULT_LATITUDE=0.0
DEFAULT_LONGITUDE=0.0

# Super Admin Default Access (Seed Configuration)
# ADMIN_USER="admin"
# ADMIN_PASS="admin"
